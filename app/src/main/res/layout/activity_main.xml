<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090909"
    android:paddingStart="15dp"
    android:paddingEnd="15dp">

    <!-- Üst başlık -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageAppLogo"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_marginEnd="9dp"
            android:src="@drawable/app"
            android:scaleType="fitCenter"
            android:contentDescription="Yumi Player logosu" />

        <TextView
            android:id="@+id/textAppName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="yumi"
            android:textColor="#F2F2F2"
            android:textSize="19sp"
            android:fontFamily="sans"
            android:letterSpacing="0.02"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/buttonSearch"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⌕"
            android:textSize="28sp"
            android:textColor="#DADADA"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Ara" />

        <TextView
            android:id="@+id/buttonSort"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="☷"
            android:textSize="22sp"
            android:textColor="#DADADA"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Sırala ve filtrele" />

        <TextView
            android:id="@+id/buttonSettings"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⚙"
            android:textSize="20sp"
            android:textColor="#DADADA"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Ayarlar" />

    </LinearLayout>

    <!-- Klasör ve görünüm araçları -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="9dp">

        <TextView
            android:id="@+id/buttonSelectFolder"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:text="▣  Video klasörü seç"
            android:textColor="#E5E5E5"
            android:textSize="13sp"
            android:background="#191919"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/buttonListView"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="☰"
            android:textSize="19sp"
            android:textColor="#AFAFAF"
            android:background="#191919"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Liste görünümü" />

        <TextView
            android:id="@+id/buttonGridView"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:text="▦"
            android:textSize="21sp"
            android:textColor="#FFFFFF"
            android:background="#292929"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Izgara görünümü" />

    </LinearLayout>

    <!-- Arama alanı -->
    <EditText
        android:id="@+id/editSearch"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="9dp"
        android:background="#191919"
        android:hint="Video ara..."
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:inputType="text"
        android:visibility="gone" />

    <!-- Mevcut sıralama altyapısıyla uyumluluk -->
    <Spinner
        android:id="@+id/spinnerSort"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- Video listesi -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewVideos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="2dp"
        android:paddingBottom="12dp"
        android:overScrollMode="never" />

</LinearLayout>
