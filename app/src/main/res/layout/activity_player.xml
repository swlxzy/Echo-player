<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        app:use_controller="true"
        app:auto_show="true"
        app:show_buffering="when_playing"
        app:keep_content_on_player_reset="true"
        app:resize_mode="fit" />

    <!-- Basılı tutma sırasında gösterilecek 2x göstergesi -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/speedIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="76dp"
        android:visibility="gone"
        app:cardBackgroundColor="#E9AD52"
        app:cardCornerRadius="50dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <TextView
            android:id="@+id/speedIndicatorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="2x"
            android:textColor="#21180C"
            android:textSize="13sp"
            android:fontFamily="sans"
            android:includeFontPadding="false" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/orientationLockButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="#66000000"
        android:gravity="center"
        android:text="↻"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:contentDescription="@string/screen_rotation_lock"
        android:clickable="true"
        android:focusable="true" />

</FrameLayout>
